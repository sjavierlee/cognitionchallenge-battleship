# Optional. All values are baked into the client bundle at build time.

# TURN relay for friend mode (without one, players behind symmetric NATs cannot connect).
# Comma-separated URLs; include a turns:…?transport=tcp entry for port-443-only networks.
# VITE_TURN_URLS=turn:relay.example.com:80,turns:relay.example.com:443?transport=tcp
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# Self-hosted PeerServer instead of the public 0.peerjs.com broker.
# VITE_PEER_HOST=
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/
# VITE_PEER_SECURE=true
